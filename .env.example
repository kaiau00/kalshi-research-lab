# Copy locally; do not commit secrets. The app reads process environment, not this file automatically.
LAB_DATA_DIR=data
LAB_DASHBOARD_PASSWORD=
LAB_MAX_STORAGE_BYTES=2000000000
LAB_MAX_REPLAY_EVENTS=2000000
LAB_REPORT_INTERVAL_SECONDS=3600
# Needed for authenticated order-book and BRTI subscriptions. Not needed for public history.
KALSHI_API_KEY_ID=
# Choose ONE private-key form; no private key has been installed by this build.
KALSHI_PRIVATE_KEY_PEM=
KALSHI_PRIVATE_KEY_B64=
KALSHI_PRIVATE_KEY_PATH=

# Optional bounded recorder + private archive (fresh LAB_DATA_DIR required).
LAB_SEGMENTED=0
LAB_SEGMENT_EVENTS=100000
LAB_SEGMENT_SECONDS=300
LAB_ARCHIVE_MAX_BYTES=20000000000
LAB_ARCHIVE_BUCKET=
LAB_ARCHIVE_ENDPOINT=
LAB_ARCHIVE_REGION=auto
LAB_ARCHIVE_STYLE=virtual
LAB_ARCHIVE_ACCESS_KEY=
LAB_ARCHIVE_SECRET_KEY=
